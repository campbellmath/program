#!/usr/bin/env bash

# Function to display usage
usage() {
    echo "Usage: $0 [username] [max_changes]"
    echo "Default: user=$USER, max=20"
    echo ""
    echo "Example: $0 wenchi 50"
    exit 1
}

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    usage
fi

# Check if p4 is installed
if ! command -v p4 &> /dev/null; then
    echo "Error: Perforce (p4) command not found."
    exit 1
fi

# Set variables with defaults
USER_NAME=${1:-$USER}
LIMIT=${2:-20}

echo "Fetching last $LIMIT submitted changes for $USER_NAME..."


SELECTED=$(p4 changes -u "$USER_NAME" -s submitted -m "$LIMIT" | \
fzf --header "Submitted Changelists (User: $USER_NAME) | enter: select+dump" \
    --preview "p4 describe -s {2}" \
    --preview-window 'up,80%,border-left' \
    --bind "ctrl-down:change-preview-window(up,80%)" \
    --bind "ctrl-up:change-preview-window(down,80%)" \
    --bind "ctrl-right:change-preview-window(left,80%)" \
    --bind "ctrl-left:change-preview-window(right,80%)" \
    --info=inline)

if [[ -n "$SELECTED" ]]; then
    CL=$(echo "$SELECTED" | awk '{print $2}')
    p4 describe -du "$CL" | delta
    echo "\n=============================================="
    echo -e "Select changelist: \033[31m$CL\033[0m"
    echo -e "To view the diff of this changelist, run:"
    echo -e "\033[32m\$ p4diff -c \033[31m$CL\033[0m"
    echo "=============================================="
fi
